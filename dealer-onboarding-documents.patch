+            ))}
+          </div>
+        </div>
+
+        <div className="list-card" style={{ padding: 14, marginBottom: 16 }}>
+          <div style={{ fontSize: 11, color: "var(--muted)", fontWeight: 600, textTransform: "uppercase", letterSpacing: "0.5px", marginBottom: 12 }}>
