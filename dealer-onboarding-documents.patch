+          </div>
+          <div style={{ display: "grid", gridTemplateColumns: "repeat(3, 1fr)", gap: 12 }}>
+            {fields.filter((f) => f.kind === "photo").map((f) => (
+              <div key={f.key} style={{ position: "relative" }}>
+                {/* file is always null here — CameraPhotoSlot's own preview needs a
