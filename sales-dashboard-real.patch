+        <div style={{ fontSize: 15, fontWeight: 800, margin: "4px 0 12px" }}>Also coming</div>
+        {comingSoon.map((c) => (
+          <ComingSoonCard key={c.title} title={c.title} description={c.description} />
+        ))}
+      </div>
+    </div>
+  );
+}
