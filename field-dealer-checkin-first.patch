From 0ae7eee2775c59b693d04aa000231be4a23a7e95 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 10 Sep 2026 05:54:38 +0000
Subject: [PATCH] Field-added dealers: always open detail page before check-in
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Two entry points let a rep reach a field-added dealer without ever
seeing its detail screen: the Check-In tab's own dealer list still
called handleCheckIn() directly on tap (single-tap instant check-in,
no confirmation), bypassing FieldDealerDetail entirely even though
Dashboard taps were already routed there.

Now the Check-In tab routes field-kind dealers to
/staff/sales/field-dealer/:id too, same as Dashboard. From that
detail screen, "Check In Here" performs the real check-in itself —
it navigates to the Check-In tab with the dealer id in nav state,
and a new effect there fires the same handleCheckIn() the list would
have, once (guarded by a ref so it can't double-fire), but only
after day-start/open-visit state has loaded and only if the day is
actually started and nothing else is already open — so it can never
bypass the existing day-start gate, it just automates the one tap
the rep would otherwise make themselves after reading the details.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01GxWPdEf21EL6SvRpGBbX8q
---
 src/screens/staff/DayCheckIn.jsx        | 34 ++++++++++++++++++++++++-
 src/screens/staff/FieldDealerDetail.jsx |  9 +++++--
 2 files changed, 40 insertions(+), 3 deletions(-)

diff --git a/src/screens/staff/DayCheckIn.jsx b/src/screens/staff/DayCheckIn.jsx
index eb7478c..a11613d 100644
--- a/src/screens/staff/DayCheckIn.jsx
+++ b/src/screens/staff/DayCheckIn.jsx
@@ -51,9 +51,16 @@ export default function DayCheckIn() {
   // auto-selection below when nothing is passed (direct URL, redirects,
   // the amber "checked in" banner, etc).
   const requestedTab = location.state?.tab === "day" || location.state?.tab === "checkin" ? location.state.tab : null;
+  // FieldDealerDetail's "Check In Here" button lands here with this set —
+  // fires the real check-in for that one dealer automatically once the
+  // Check In tab is ready (day started, nothing else open), so the rep
+  // never has to tap the dealer a second time after already picking it
+  // on the detail screen.
+  const autoCheckInDealerId = location.state?.autoCheckInDealer?.id || null;
 
   const [activeTab, setActiveTab] = useState("day");
   const defaultTabSetRef = useRef(false);
+  const autoCheckInFiredRef = useRef(false);
 
   const [dayStart, setDayStart] = useState(null);
   const [loadingDayStart, setLoadingDayStart] = useState(true);
@@ -393,6 +400,18 @@ export default function DayCheckIn() {
   const dayEnded = !!dayStart?.ended_at;
   const dayStarted = !!dayStart;
 
+  useEffect(() => {
+    if (!autoCheckInDealerId || autoCheckInFiredRef.current) return;
+    // Only fire once everything the normal tap-to-check-in flow depends on
+    // has actually loaded, so this never bypasses the day-start gate or
+    // double-checks-in over an already-open visit — it just automates the
+    // same single tap the dealer list itself would have done.
+    if (loadingDayStart || loadingOpenVisit || loadingDealers) return;
+    if (!dayStarted || dayEnded || openVisit || checkingInId) return;
+    autoCheckInFiredRef.current = true;
+    handleCheckIn({ id: autoCheckInDealerId });
+  }, [autoCheckInDealerId, loadingDayStart, loadingOpenVisit, loadingDealers, dayStarted, dayEnded, openVisit, checkingInId]);
+
   return (
     <div style={{ minHeight: "100vh", background: "#f5f5f7", fontFamily: "'Segoe UI', Arial, sans-serif" }}>
       <div style={{ background: "linear-gradient(135deg, #7B2D8B 0%, #a13ea9 100%)", padding: "18px 20px 0", color: "#fff" }}>
@@ -717,7 +736,20 @@ export default function DayCheckIn() {
                     filteredDealers.map((d) => (
                       <div
                         key={d.id}
-                        onClick={() => (checkingInId ? null : handleCheckIn(d))}
+                        onClick={() => {
+                          if (checkingInId) return;
+                          // A dealer someone added straight from the field
+                          // — show its account-like detail page first (what
+                          // was entered, location, past visits) rather than
+                          // checking in the instant it's tapped. The detail
+                          // page's own "Check In Here" button completes the
+                          // check-in from there.
+                          if (d.dealer_kind && d.dealer_kind !== "profile") {
+                            navigate(`/staff/sales/field-dealer/${d.id}`);
+                          } else {
+                            handleCheckIn(d);
+                          }
+                        }}
                         style={{
                           display: "flex", alignItems: "center", gap: 12, padding: "12px 4px", borderBottom: "1px solid #f2e6f4",
                           cursor: checkingInId ? "default" : "pointer", opacity: checkingInId && checkingInId !== d.id ? 0.5 : 1,
diff --git a/src/screens/staff/FieldDealerDetail.jsx b/src/screens/staff/FieldDealerDetail.jsx
index c0664d0..3f063b7 100644
--- a/src/screens/staff/FieldDealerDetail.jsx
+++ b/src/screens/staff/FieldDealerDetail.jsx
@@ -175,11 +175,16 @@ export default function FieldDealerDetail() {
         </div>
 
         <button
-          onClick={() => navigate("/staff/sales/day-checkin", { state: { tab: "checkin" } })}
+          onClick={() => navigate("/staff/sales/day-checkin", {
+            state: { tab: "checkin", autoCheckInDealer: { id: dealer.id, name: dealer.shop_name } },
+          })}
           style={{ width: "100%", padding: 13, border: "none", borderRadius: 10, background: "#7B2D8B", color: "#fff", fontSize: 14, fontWeight: 800, cursor: "pointer" }}
         >
-          📍 Go to Check In
+          📍 Check In Here
         </button>
+        <div style={{ fontSize: 11, color: "#999", textAlign: "center", marginTop: 8, lineHeight: 1.5 }}>
+          You must be within 100m to check in. If your day isn't started yet, you'll be asked to start it first.
+        </div>
       </div>
     </div>
   );
-- 
