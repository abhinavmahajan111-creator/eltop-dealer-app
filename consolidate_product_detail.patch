+              </div>
+              {showSpecs && (
+                <table style={{ width: '100%', borderCollapse: 'collapse' }}>
+                  <tbody>{SPEC_FIELDS.map(({ key, label }) => renderRow(key, label, specs[key], specsVis))}</tbody>
