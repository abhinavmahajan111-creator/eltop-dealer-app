From 5a5436fb71ea771eb68ab8db775be5bbfc0dcbd7 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 3 Sep 2026 06:37:36 +0000
Subject: [PATCH] Add website to the ledger PDF letterhead
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Small follow-up to the Tally-style ledger layout — www.EltopByEmbassy.com
alongside the email line, matching the same letterhead line
generatePriceListPDF.js already prints.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01GxWPdEf21EL6SvRpGBbX8q
---
 src/lib/dealerCrmUtils.js | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/src/lib/dealerCrmUtils.js b/src/lib/dealerCrmUtils.js
index 5b59762..5d14fb4 100644
--- a/src/lib/dealerCrmUtils.js
+++ b/src/lib/dealerCrmUtils.js
@@ -140,6 +140,7 @@ const COMPANY_INFO = {
   gstin: "07AAGCE1173M1ZH",
   udyam: "UDYAM-DL-06-0006878",
   email: "embassyelectricindia@gmail.com",
+  website: "www.EltopByEmbassy.com",
 };
 
 // Tally-style ledger statement PDF — a proper letterhead (company name/
@@ -168,7 +169,7 @@ export function exportLedgerStatementPdf({ dealer, dealerCode, fromLabel, toLabe
   center(COMPANY_INFO.name, 13, [123, 45, 139], true);
   COMPANY_INFO.addressLines.forEach((line) => center(line, 8.5, [110, 110, 110], false));
   center(`GSTIN: ${COMPANY_INFO.gstin}  |  UDYAM: ${COMPANY_INFO.udyam}`, 8.5, [110, 110, 110], false);
-  center(COMPANY_INFO.email, 8.5, [110, 110, 110], false);
+  center(`${COMPANY_INFO.email}  |  ${COMPANY_INFO.website}`, 8.5, [110, 110, 110], false);
 
   y += 6;
   doc.setDrawColor(220, 200, 228);
-- 
